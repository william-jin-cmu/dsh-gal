{
  "name": "@dsh-external/dsh-gal",
  "version": "0.1.0",
  "description": "Galgame / visual-novel UI for the DeepSeek Harness: a whale-girl companion with animated expressions who speaks the assistant's replies one scene at a time",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "web", "assets/sprites", "assets/motion"],
  "license": "BSD-3-Clause",
  "engines": { "dsh": ">=0.0.1" },
  "dshx": {
    "contributes": { "tools": [], "skills": [] }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.0.1",
    "@deepseek-ai/dsh-session": "^0.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
